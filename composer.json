{
  "name": "assegaiphp/starter",
  "description": "The official starter application for AssegaiPHP.",
  "type": "project",
  "scripts": {
    "start": "php -S localhost:5000 -t public index.php",
    "test": "vendor/bin/pest",
    "setup": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php -r \"file_exists('config/secure.php') || copy('config/secure.php.example', 'config/secure.php');\""
    ],
    "post-root-package-install": "@setup",
    "post-install-cmd": "@setup"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Assegai\\App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [],
  "require": {
    "php": "^8.4",
    "ext-pdo": "*",
    "ext-curl": "*",
    "vlucas/phpdotenv": "^5.4",
    "assegaiphp/core": "^0.10.0"
  },
  "require-dev": {
    "pestphp/pest": "^4.1"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  }
}
